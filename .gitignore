# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production
.dev.vars

# macOS-specific files
.DS_Store

# local-only docs / agent instructions / screenshots
AGENTS.md
CLAUDE.md
docs/
agent-demo-desktop.png
agent-demo-mobile.png
agent-demo-tablet.png

# opencode project skills: keep tracked skill sources, ignore local deps/tool files
.opencode/*
!.opencode/skills/
!.opencode/skills/prebuild-docs/
!.opencode/skills/prebuild-docs/**
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
.opencode/.gitignore

# opencode runtime / continuation state
.omo/
.codegraph/
.playwright-mcp/

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Cloudflare Wrangler local state
.wrangler/

# keep app data modules tracked even if a global gitignore ignores generic data/
!src/data/
!src/data/*.ts
