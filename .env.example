# 复制本文件为 .env 并填入真实值。.env 不会进 git。
# 生产环境通过 Cloudflare Secrets 注入同名变量，不使用本文件。

# LLM 供应商 API key
DEEPSEEK_API_KEY=your_deepseek_api_key_here
MIMO_API_KEY=your_mimo_api_key_here

# OpenAI-compatible endpoint 配置（两家都必须显式填写）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
MIMO_BASE_URL=https://api.xiaomimimo.com
MIMO_MODEL=mimo-v2.5-pro

# 当前生效供应商：deepseek | mimo | test
# test 用于 E2E 测试，走 fake provider，不调真实 API，不花钱
ACTIVE_PROVIDER=deepseek

# 同页对话上下文加密密钥（生产环境必须通过 Cloudflare Secret 注入）
AGENT_CONTEXT_SECRET=replace_with_a_long_random_secret

# 推理请求参数（留空则完全不传）
# TEMPERATURE 示例：0.7
TEMPERATURE=0.7
# EFFORT 可选：high | max | disabled
EFFORT=high

# admin 面板访问 token（阶段 4 才用，先留占位符）
ADMIN_TOKEN=your_admin_token_here

# D1 数据库绑定
# 本地开发不需要配置（走 fake store）
# 生产环境通过 wrangler.toml 的 [[d1_databases]] 绑定，binding 名为 DB
# 部署前需要：
#   1. wrangler d1 create portfolio-db
#   2. 将返回的 database_id 填入 wrangler.toml
#   3. wrangler d1 execute portfolio-db --file migrations/0001_stage3_data_collection.sql
