{
  "name": "portfolio-website",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "npm run build && tsx scripts/pages-dev.ts",
    "dev:astro": "astro dev",
    "build": "node scripts/generate-agent-materials.mjs && astro build",
    "preview": "tsx scripts/pages-dev.ts",
    "preview:astro": "astro preview",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:schema": "tsx tests/schema-validation.ts",
    "test:lighthouse": "node scripts/lighthouse-check.mjs",
    "test:agent-provider": "node scripts/generate-agent-materials.mjs && tsx scripts/verify-agent-provider.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260625.1",
    "@playwright/test": "^1.49.0",
    "lighthouse": "^13.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "astro": "^7.0.2"
  }
}
