---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import ResumeEducationSection from '../components/resume/ResumeEducationSection.astro';
import ResumeExperienceSection from '../components/resume/ResumeExperienceSection.astro';
import ResumeProjectIndexSection from '../components/resume/ResumeProjectIndexSection.astro';
import ResumeSkillsSection from '../components/resume/ResumeSkillsSection.astro';
import Footer from '../components/Footer.astro';
import profile from '../../content/profile.json';
import { resumeData } from '../data/resume';
import { getCollection } from 'astro:content';
import { hasResumePdf } from '../utils/resume-pdf';

const education = resumeData.education;
const experience = resumeData.experience;
const skills = resumeData.skills;
const projects = await getCollection('projects');
const resumePdfAvailable = hasResumePdf();
---

<Base title={`在线简历 — ${profile.name}`}>
  <Nav name={profile.name} projects={projects} hasResumePdf={resumePdfAvailable} />
  <section class="resume-header-shell">
    <div class="grid">
      <PageHeader title="在线简历" description={profile.description} class="resume-page-header">
        <div slot="action" class="resume-actions">
          {resumePdfAvailable ? (
            <a href="/resume.pdf" download class="resume-action resume-action-primary">下载 PDF 简历</a>
          ) : (
            <span class="resume-action resume-action-disabled">PDF 简历待补充</span>
          )}
          <a href="/agent/" class="resume-action resume-action-secondary">与 Agent 对话</a>
        </div>
      </PageHeader>
    </div>
  </section>
  <div class="grid"><div class="hairline"></div></div>
  <ResumeEducationSection education={education} />
  <ResumeExperienceSection experience={experience} />
  <ResumeSkillsSection skills={skills} />
  <ResumeProjectIndexSection projects={projects} />
  <Footer github={profile.github} homepage={profile.homepage} email={profile.email} />
</Base>

<style>
  .resume-header-shell {
    padding: 10rem 0 4rem;
  }

  .resume-page-header {
    grid-column: 1 / -1;
  }

  .resume-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  .resume-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.75rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-button);
    font-size: 0.9rem;
    transition: var(--transition);
  }

  .resume-action-primary {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }

  .resume-action-primary:hover {
    opacity: 0.82;
  }

  .resume-action-secondary {
    background: transparent;
    color: var(--fg-secondary);
  }

  .resume-action-secondary:hover {
    border-color: var(--fg);
    color: var(--fg);
  }

  .resume-action-disabled {
    background: var(--bg-muted);
    color: var(--fg-muted);
    font-weight: 500;
    cursor: default;
  }

  @media (max-width: 768px) {
    .resume-header-shell {
      padding: 7rem 0 3rem;
    }

    .resume-actions {
      justify-content: flex-start;
    }
  }
</style>
