---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ProjectDetailBody from '../../components/projects/ProjectDetailBody.astro';
import ProjectDetailHeader from '../../components/projects/ProjectDetailHeader.astro';
import profile from '../../../content/profile.json';
import { getCollection, render } from 'astro:content';
import { hasResumePdf } from '../../utils/resume-pdf';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project, projects },
  }));
}

const { project, projects } = Astro.props;
const { Content } = await render(project);
const typeLabel = project.data.type === 'internship' ? '实习项目' : '个人项目';
const resumePdfAvailable = hasResumePdf();
---

<Base title={`${project.data.name} — ${profile.name}`}>
  <Nav name={profile.name} projects={projects} hasResumePdf={resumePdfAvailable} />
  <article>
    <ProjectDetailHeader project={project} typeLabel={typeLabel} />

    <div class="article-divider">
      <div class="grid">
        <div class="hairline"></div>
      </div>
    </div>

    <ProjectDetailBody Content={Content} />
  </article>
  <Footer github={profile.github} homepage={profile.homepage} email={profile.email} />
</Base>

<style>
  .article-divider {
    margin: 2rem 0;
  }
</style>
