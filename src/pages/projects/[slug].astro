---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import profile from '../../../content/profile.json';
import { getCollection, render } from 'astro:content';
import { hasResumePdf } from '../../utils/resume-pdf';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project, projects },
  }));
}

const { project, projects } = Astro.props;
const { Content } = await render(project);
const typeLabel = project.data.type === 'internship' ? '实习项目' : '个人项目';
const resumePdfAvailable = hasResumePdf();
---

<Base title={`${project.data.name} — ${profile.name}`}>
  <Nav name={profile.name} projects={projects} hasResumePdf={resumePdfAvailable} />
  <article class="container" style="padding-top: 8rem;">
    <header class="project-meta">
      <div class="project-type-badge">{typeLabel}</div>
      <h1 class="project-title">{project.data.name}</h1>
      <div class="project-info">
        <span>{project.data.role}</span>
        <span class="dot">·</span>
        <span>{project.data.period}</span>
        {project.data.type === 'internship' && project.data.company && (
          <><span class="dot">·</span><span>{project.data.company}</span></>
        )}
      </div>
      {project.data.tags.length > 0 && (
        <div class="project-tags">
          {project.data.tags.map((tag) => <span class="project-tag">{tag}</span>)}
        </div>
      )}
      {project.data.links && (
        <div class="project-links">
          {project.data.links.github && <a href={project.data.links.github} target="_blank">GitHub</a>}
          {project.data.links.demo && <a href={project.data.links.demo} target="_blank">产品主页</a>}
          {project.data.links.docs && <a href={project.data.links.docs} target="_blank">文档</a>}
        </div>
      )}
    </header>
    <div class="project-body">
      <Content />
    </div>
    <div class="back-link">
      <a href="/projects/">← 返回项目列表</a>
    </div>
  </article>
  <Footer github={profile.github} homepage={profile.homepage} email={profile.email} />
</Base>

<style>
  .project-meta {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }
  .project-type-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: var(--accent-bg);
    color: var(--accent-dark);
    border-radius: var(--radius-pill);
    font-size: 0.75rem;
    font-weight: 500;
    margin-bottom: 1rem;
  }
  .project-title {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }
  .project-info {
    color: var(--fg-secondary);
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }
  .dot {
    margin: 0 0.5rem;
    color: var(--fg-muted);
  }
  .project-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .project-tag {
    padding: 0.3rem 0.7rem;
    background: var(--bg);
    border-radius: var(--radius-tag);
    font-size: 0.8rem;
    color: var(--fg-muted);
  }
  .project-links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .project-links a {
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-tag);
    font-size: 0.85rem;
    color: var(--fg-secondary);
    transition: var(--transition);
  }
  .project-links a:hover {
    border-color: var(--fg);
    color: var(--fg);
  }
  .project-body {
    color: var(--fg);
    font-size: 0.98rem;
    line-height: 1.7;
  }
  .project-body :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.25;
  }
  .project-body :global(h2:first-child) {
    margin-top: 0;
  }
  .project-body :global(h3) {
    font-size: 1.1rem;
    font-weight: 600;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    line-height: 1.35;
  }
  .project-body :global(p) {
    margin-bottom: 1rem;
  }
  .project-body :global(strong) {
    color: var(--fg);
    font-weight: 600;
  }
  .project-body :global(em) {
    font-style: italic;
  }
  .project-body :global(a) {
    color: var(--accent-dark);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.18em;
    transition: var(--transition);
  }
  .project-body :global(a:hover) {
    color: var(--fg);
    text-decoration-color: var(--accent-dark);
  }
  .project-body :global(ul) {
    list-style: disc;
    margin: 0 0 1rem;
    padding-left: 1.5rem;
  }
  .project-body :global(ol) {
    list-style: decimal;
    margin: 0 0 1rem;
    padding-left: 1.5rem;
  }
  .project-body :global(li) {
    margin-bottom: 0.5rem;
  }
  .project-body :global(li > ul),
  .project-body :global(li > ol) {
    margin-top: 0.5rem;
    margin-bottom: 0;
  }
  .project-body :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.25rem 0;
  }
  .project-body :global(blockquote) {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--accent);
    background: var(--accent-bg);
    color: var(--fg-secondary);
    border-radius: 0 var(--radius-button) var(--radius-button) 0;
  }
  .project-body :global(blockquote p:last-child) {
    margin-bottom: 0;
  }
  .project-body :global(code) {
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-tag);
    background: var(--bg-muted);
    color: var(--fg);
    font-size: 0.9em;
    font-family: ui-monospace, "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    word-break: break-word;
  }
  .project-body :global(pre) {
    margin: 1.5rem 0;
    padding: 1rem 1.125rem;
    border-radius: var(--radius-button);
    overflow-x: auto;
    line-height: 1.7;
  }
  .project-body :global(pre.astro-code) {
    border: 1px solid var(--border-hover);
  }
  .project-body :global(pre:not(.astro-code)) {
    background: var(--fg);
    color: var(--bg);
  }
  .project-body :global(pre code) {
    padding: 0;
    border-radius: 0;
    background: none;
    color: inherit;
    font-size: 0.875rem;
    word-break: normal;
  }
  .project-body :global(table) {
    display: table;
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    background: var(--bg-elevated);
    font-size: 0.92rem;
    line-height: 1.6;
  }
  .project-body :global(th),
  .project-body :global(td) {
    border: 1px solid var(--border);
    padding: 0.7rem 0.85rem;
    text-align: left;
    vertical-align: top;
    overflow-wrap: break-word;
  }
  .project-body :global(th) {
    background: var(--bg-muted);
    color: var(--fg);
    font-weight: 600;
  }
  .project-body :global(tbody tr:nth-child(even) td) {
    background: var(--bg);
  }
  .back-link {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .back-link a {
    color: var(--accent-dark);
    font-size: 0.9rem;
    font-weight: 500;
    transition: var(--transition);
  }
  .back-link a:hover {
    color: var(--fg);
  }
  @media (max-width: 640px) {
    .project-title {
      font-size: 1.75rem;
    }
    .project-body {
      font-size: 0.95rem;
    }
    .project-body :global(h2) {
      font-size: 1.35rem;
    }
    .project-body :global(table) {
      font-size: 0.85rem;
    }
    .project-body :global(th),
    .project-body :global(td) {
      padding: 0.6rem 0.7rem;
    }
  }
</style>
