---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Hairline from '../../components/layout/Hairline.astro';
import ProjectListItem from '../../components/projects/ProjectListItem.astro';
import Footer from '../../components/Footer.astro';
import profile from '../../../content/profile.json';
import { getCollection } from 'astro:content';
import { hasResumePdf } from '../../utils/resume-pdf';

const projects = await getCollection('projects');
const personalProjects = projects.filter((project) => project.data.type === 'personal');
const internshipProjects = projects.filter((project) => project.data.type === 'internship');
const resumePdfAvailable = hasResumePdf();

const projectGroups = [
  { index: '01', title: '个人项目', projects: personalProjects },
  { index: '02', title: '实习项目', projects: internshipProjects },
];
---

<Base title={`项目 — ${profile.name}`}>
  <Nav name={profile.name} projects={projects} hasResumePdf={resumePdfAvailable} />
  <section class="projects-header-shell">
    <div class="grid">
      <PageHeader title="全部项目" class="projects-page-header" />
    </div>
  </section>

  <div class="grid">
    <Hairline />
  </div>

  {projectGroups.map((group) => (
    <section class="project-group">
      <div class="grid">
        <div class="project-group-label">
          <span>{group.index}</span>
          {group.title}
        </div>

        <div class="projects-list">
          {group.projects.map((project, index) => (
            <ProjectListItem project={project} index={index} />
          ))}
        </div>
      </div>
    </section>
  ))}

  <Footer github={profile.github} homepage={profile.homepage} email={profile.email} />
</Base>

<style>
  .projects-header-shell {
    padding: 10rem 0 4rem;
  }

  .projects-page-header {
    grid-column: 1 / -1;
  }

  .project-group {
    padding: 4rem 0;
  }

  .project-group-label {
    grid-column: 1 / 3;
    padding-top: 0.4rem;
    font-size: 0.7rem;
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 500;
  }

  .project-group-label span {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.65rem;
    color: var(--border-hover);
  }

  .projects-list {
    grid-column: 4 / 12;
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 768px) {
    .projects-header-shell {
      padding: 7rem 0 3rem;
    }

    .project-group {
      padding: 3rem 0;
    }

    .project-group-label,
    .projects-list {
      grid-column: 1 / -1;
    }

    .project-group-label {
      margin-bottom: 2rem;
    }
  }
</style>
