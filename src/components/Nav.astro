---
const { name, projects = [], hasResumePdf = false } = Astro.props;
---

<nav>
  <div class="nav-container grid">
    <ul class="nav-links">
      <li><a href="/" class="nav-link">首页</a></li>
      <li><a href="/resume/" class="nav-link">简历</a></li>
      <li><a href="/projects/" class="nav-link">项目</a></li>
      <li><a href="/agent/" class="nav-link">Agent</a></li>
    </ul>
  </div>
</nav>

<script is:inline>
  // Dropdown functionality removed - nav items now link directly to pages
</script>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 1.25rem 0;
    background: rgba(250, 248, 245, 0.9);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
  }
  .nav-container {
    align-items: center;
  }
  .nav-links {
    grid-column: 1 / -1;
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    list-style: none;
    align-items: center;
    flex-wrap: wrap;
  }
  .dropdown-label {
    background: transparent;
    border: none;
    padding: 0.55rem 0.9rem;
    border-radius: var(--radius-pill);
    color: var(--fg-muted);
    font-size: 0.82rem;
    font-family: inherit;
    cursor: pointer;
    transition: var(--transition);
    letter-spacing: 0.05em;
    white-space: nowrap;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.25rem;
    padding: 0.55rem 0.9rem;
    border-radius: var(--radius-pill);
    color: var(--fg-muted);
    font-size: 0.82rem;
    letter-spacing: 0.05em;
    transition: var(--transition);
    white-space: nowrap;
  }
  .nav-link:hover,
  .nav-link:focus-visible {
    background: var(--fg);
    color: var(--bg);
    outline: none;
  }
  @media (max-width: 768px) {
    nav {
      padding: 1rem 0;
    }

    .nav-links {
      grid-column: 1 / -1;
    }

    .nav-container {
      row-gap: 0.75rem;
    }

    .nav-links {
      justify-content: flex-start;
    }

    .nav-links {
      gap: 0.5rem;
    }

    .dropdown-label {
      font-size: 0.8rem;
    }

    .nav-link {
      font-size: 0.8rem;
    }
  }
</style>
