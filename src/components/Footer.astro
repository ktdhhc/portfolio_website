---
const { github, homepage, email, showAdmin } = Astro.props;
---

<footer>
  <div class="footer-container">
    <div class="footer-links">
      {github && <a href={github} target="_blank">GitHub</a>}
      {homepage && <a href={homepage} target="_blank">产品主页</a>}
      {email && <a href={`mailto:${email}`}>Email</a>}
    </div>
    <p class="footer-copy">
      © 2026 Kaho
      {showAdmin && <a href="/admin" class="admin-link">Admin</a>}
    </p>
  </div>
</footer>

<style>
  footer {
    padding: 3rem 0;
    text-align: center;
  }
  .footer-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--container-padding);
  }
  .footer-links {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }
  .footer-links a {
    color: var(--fg-secondary);
    font-size: 0.9rem;
    transition: var(--transition);
  }
  .footer-links a:hover {
    color: var(--fg);
  }
  .footer-copy {
    font-size: 0.8rem;
    color: var(--fg-muted);
  }
  .admin-link {
    margin-left: 0.5rem;
    font-size: 0.75rem;
    color: var(--fg-muted);
    text-decoration: none;
    transition: var(--transition);
  }
  .admin-link:hover {
    color: var(--fg-secondary);
  }
</style>
