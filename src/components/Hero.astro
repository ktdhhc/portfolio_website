---
import HomeHeroEnglishLayer from './home/HomeHeroEnglishLayer.astro';
import HomeHeroChineseLayer from './home/HomeHeroChineseLayer.astro';
import HomeHeroFooter from './home/HomeHeroFooter.astro';
import HomeHeroSpotlightScript from './home/HomeHeroSpotlightScript.astro';

const { profile, hasResumePdf = false } = Astro.props;

const heroStatusText = '正在寻找 AI Agent / 认知产品方向机会';
const englishBio = `M.S. in Applied Psychology, SCNU. Working across AI Agent prototyping, benchmark evaluation, and independent product building.`;
const placeholderTags = [
  { label: 'INTJ', top: '18%', left: '72%' },
  { label: '完美极简主义者', top: '32%', left: '50%' },
  { label: 'Vibe Coding', top: '12%', left: '80%' },
  { label: '8G 冲浪', top: '48%', left: '55%' },
  { label: '业余吉他手', top: '60%', left: '72%' },
  { label: '港乐发烧友', top: '72%', left: '58%' },
  { label: '硬核科幻迷', top: '35%', left: '82%' },
  { label: '资深 B 站研究员', top: '82%', left: '78%' },
  { label: '心理学硕士', top: '15%', left: '40%' },
  { label: '中羽0级运动员', top: '82%', left: '35%' },
  { label: '钢琴练习时长两年半', top: '18%', left: '7%' },
  { label: '自我驱动型', top: '46%', left: '5%' },
  { label: '栋笃笑15年老粉', top: '72%', left: '3%' },
  { label: 'Prompt Engineering', top: '90%', left: '60%' },
];
---

<section class="hero" id="hero">
  <div class="hero-spotlight">
    <HomeHeroEnglishLayer
      name={profile.name}
      englishBio={englishBio}
      placeholderTags={placeholderTags}
      hasResumePdf={hasResumePdf}
    />
    <HomeHeroChineseLayer
      name={profile.name}
      description={profile.description}
      hasResumePdf={hasResumePdf}
    />
  </div>

  <HomeHeroFooter statusText={heroStatusText} />
</section>

<HomeHeroSpotlightScript />

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .hero-spotlight {
    position: relative;
    flex: 1;
  }
</style>
