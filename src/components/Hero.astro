---
import Badge from '../components/Badge.astro';
import Button from '../components/Button.astro';

const { profile, hasResumePdf = false } = Astro.props;
---

<section class="hero">
  <div class="container">
    <Badge text="正在寻找 AI Agent / 产品方向机会" />
    <h1><span class="accent">AI</span> 协同进化者<br />重塑产品边界</h1>
    <p class="hero-desc">{profile.description}</p>
    <div class="hero-actions">
      {hasResumePdf ? (
        <Button variant="primary" href="/resume.pdf">下载简历 (PDF)</Button>
      ) : (
        <span class="pdf-unavailable">PDF 简历待补充</span>
      )}
      <Button variant="secondary" href="#agent">与资料 Agent 对话</Button>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: var(--hero-padding-top) 0 var(--hero-padding-bottom);
    text-align: center;
  }
  h1 {
    font-size: 3.5rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }
  .accent {
    color: var(--accent-dark);
  }
  .hero-desc {
    font-size: 1.15rem;
    color: var(--fg-secondary);
    max-width: 560px;
    margin: 0 auto 2.5rem;
    line-height: 1.7;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .pdf-unavailable {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-button);
    background: var(--bg-muted);
    color: var(--fg-muted);
    font-size: 0.9rem;
    font-weight: 500;
    cursor: default;
  }
  @media (max-width: 640px) {
    .hero {
      padding: var(--hero-padding-top-mobile) 0 var(--hero-padding-bottom-mobile);
    }
    h1 {
      font-size: 2.25rem;
    }
  }
</style>
