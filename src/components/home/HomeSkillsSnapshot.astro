---
import SectionLabel from '../layout/SectionLabel.astro';
import { resumeSkillGroups } from '../../data/resume';

const { skills = [] } = Astro.props;

const groupLabels = {
  core: '核心能力',
  tool: '工程工具',
  research: '研究分析',
} as const;

const groupedSkills = resumeSkillGroups.map((group) => ({
  key: group,
  label: groupLabels[group],
  skills: skills.filter((skill) => skill.group === group),
}));
---

<section id="skills" class="home-section">
  <div class="grid">
    <SectionLabel index="02" label="技能" class="home-section-label">
      <div class="skills-group">
        {groupedSkills.map((group) => (
          <section class="skill-col">
            <h3>{group.label}</h3>
            <ul>
              {group.skills.map((skill) => (
                <li class:list={{ highlight: skill.highlight }}>{skill.name}</li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </SectionLabel>
  </div>
</section>

<style>
  .home-section {
    padding: 6.5rem 0;
  }

  .home-section-label {
    grid-column: 1 / -1;
  }

  .skills-group {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 4rem;
  }

  .skill-col h3 {
    font-size: 0.7rem;
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1.5rem;
    font-weight: 500;
  }

  .skill-col ul {
    list-style: none;
  }

  .skill-col li {
    font-size: 1rem;
    color: var(--fg-secondary);
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
  }

  .skill-col li:last-child {
    border-bottom: none;
  }

  .skill-col li.highlight {
    color: var(--fg);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .home-section {
      padding: 5rem 0;
    }

    .skills-group {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
