<script is:inline>
  (function () {
    var hero = document.getElementById('hero');
    var heroSpotlight = hero ? hero.querySelector('.hero-spotlight') : null;
    var heroZh = hero ? hero.querySelector('.hero-zh') : null;
    var heroFront = hero ? hero.querySelector('.hero-front') : null;
    var heroFlipper = hero ? hero.querySelector('[data-hero-flipper]') : null;
    var aboutButton = hero ? hero.querySelector('[data-hero-about]') : null;
    var backButton = hero ? hero.querySelector('[data-hero-back]') : null;
    if (!hero || !heroSpotlight || !heroZh || !heroFlipper) return;

    var isMobile = window.innerWidth <= 768 || !window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    function showCard() {
      hero.classList.add('is-card-open');
      if (!isMobile) {
        heroFlipper.style.transform = 'rotateX(180deg)';
      }
      if (heroFront instanceof HTMLElement) heroFront.style.pointerEvents = 'none';
    }

    function hideCard() {
      hero.classList.remove('is-card-open');
      if (!isMobile) {
        heroFlipper.style.transform = 'rotateX(0deg)';
      }
      if (heroFront instanceof HTMLElement) heroFront.style.pointerEvents = '';
    }

    if (aboutButton instanceof HTMLElement) {
      aboutButton.addEventListener('click', function () {
        showCard();
      });
    }

    if (backButton instanceof HTMLElement) {
      backButton.addEventListener('click', function () {
        hideCard();
      });
    }

    var heroEn = hero ? hero.querySelector('.hero-en') : null;

    var canSpotlight = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    var useMobileToggle = window.innerWidth <= 768 || !canSpotlight;
    if (useMobileToggle) {
      var isRevealed = false;

      // 初始状态：亮色层按钮可点击，亮色层本身不拦截点击；暗色层不可点击
      if (heroEn instanceof HTMLElement) {
        heroEn.style.pointerEvents = 'none';
      }
      if (heroZh instanceof HTMLElement) {
        heroZh.style.pointerEvents = 'none';
      }
      var actionsMobile = heroZh ? heroZh.querySelector('.hero-actions-mobile') : null;
      if (actionsMobile instanceof HTMLElement) {
        actionsMobile.style.pointerEvents = 'auto';
      }

      heroSpotlight.addEventListener('click', function (event) {
        var target = event.target;
        if (!(target instanceof Element)) return;
        if (target.closest('a') || target.closest('button')) return;

        isRevealed = !isRevealed;
        heroZh.style.opacity = isRevealed ? '0' : '1';

        if (heroEn instanceof HTMLElement) {
          heroEn.style.pointerEvents = isRevealed ? 'auto' : 'none';
        }
        var actionsEn = heroEn ? heroEn.querySelector('.hero-actions') : null;
        if (actionsEn instanceof HTMLElement) {
          actionsEn.style.pointerEvents = isRevealed ? 'auto' : 'none';
        }
        var aboutBtn = heroEn ? heroEn.querySelector('[data-hero-about]') : null;
        if (aboutBtn instanceof HTMLElement) {
          aboutBtn.style.pointerEvents = isRevealed ? 'auto' : 'none';
        }

        if (heroZh instanceof HTMLElement) {
          heroZh.style.pointerEvents = 'none';
        }
        if (actionsMobile instanceof HTMLElement) {
          actionsMobile.style.pointerEvents = isRevealed ? 'none' : 'auto';
        }
      });

      return;
    }

    hero.addEventListener('mousemove', function (event) {
      var rect = hero.getBoundingClientRect();
      hero.style.setProperty('--spotlight-x', event.clientX - rect.left + 'px');
      hero.style.setProperty('--spotlight-y', event.clientY - rect.top + 'px');
    });

    hero.addEventListener('mouseleave', function () {
      hero.style.setProperty('--spotlight-x', '-9999px');
      hero.style.setProperty('--spotlight-y', '-9999px');
    });
  })();
</script>
