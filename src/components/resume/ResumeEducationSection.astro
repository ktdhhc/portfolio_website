---
import SectionLabel from '../layout/SectionLabel.astro';

const { education = [] } = Astro.props;
---

<section id="education" class="resume-section">
  <div class="grid">
    <SectionLabel index="01" label="教育" class="resume-section-label">
      <ul class="edu-list">
        {education.map((entry) => (
          <li>
            <h2>{entry.school} · {entry.degree}</h2>
            <span class="sub">{entry.detail}</span>
            <span class="time">{entry.period}</span>
          </li>
        ))}
      </ul>
    </SectionLabel>
  </div>
</section>

<style>
  .resume-section {
    padding: 6rem 0;
  }

  .resume-section-label {
    grid-column: 1 / -1;
  }

  .edu-list {
    list-style: none;
  }

  .edu-list li {
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--border);
  }

  .edu-list li:first-child {
    padding-top: 0;
  }

  .edu-list h2 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.35rem;
  }

  .sub,
  .time {
    display: block;
  }

  .sub {
    font-size: 0.9rem;
    color: var(--fg-secondary);
    margin-bottom: 0.25rem;
  }

  .time {
    font-size: 0.8rem;
    color: var(--fg-muted);
  }

  @media (max-width: 768px) {
    .resume-section {
      padding: 4rem 0;
    }
  }
</style>
