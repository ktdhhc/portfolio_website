---
import SectionLabel from '../layout/SectionLabel.astro';

const { experience = [] } = Astro.props;
---

<section id="experience" class="resume-section">
  <div class="grid">
    <SectionLabel index="02" label="实习" class="resume-section-label">
      <div class="experience-stack">
        {experience.map((entry) => (
          <article class="experience-entry">
            <header class="exp-header">
              <h2>{entry.title}</h2>
              <span class="sub">{entry.company}</span>
              <span class="time">{entry.period}</span>
            </header>
            <p class="exp-desc">{entry.description}</p>
            <ul class="exp-list">
              {entry.projects.map((project) => (
                <li>
                  <strong>{project.title}</strong>
                  <p>{project.description}</p>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </SectionLabel>
  </div>
</section>

<style>
  .resume-section {
    padding: 6rem 0;
  }

  .resume-section-label {
    grid-column: 1 / -1;
  }

  .experience-stack {
    display: grid;
    gap: 3rem;
  }

  .exp-header {
    margin-bottom: 1.5rem;
  }

  .exp-header h2 {
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 0.25rem;
  }

  .sub,
  .time {
    display: block;
  }

  .sub {
    font-size: 0.9rem;
    color: var(--accent-dark);
    font-weight: 500;
  }

  .time {
    font-size: 0.8rem;
    color: var(--fg-muted);
    margin-top: 0.5rem;
  }

  .exp-desc {
    font-size: 0.95rem;
    color: var(--fg-secondary);
    line-height: 1.8;
    margin-bottom: 2rem;
    max-width: 37.5rem;
  }

  .exp-list {
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .exp-list li {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
  }

  .exp-list strong {
    display: block;
    font-weight: 600;
    margin-bottom: 0.35rem;
    font-size: 0.95rem;
  }

  .exp-list p {
    font-size: 0.88rem;
    color: var(--fg-secondary);
    line-height: 1.7;
    max-width: 35rem;
  }

  @media (max-width: 768px) {
    .resume-section {
      padding: 4rem 0;
    }
  }
</style>
