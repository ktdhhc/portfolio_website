<section class="container module-card logs-module" data-module="logs">
  <div class="section-header compact">
    <div>
      <span class="section-tag">Logs</span>
      <h3>提问记录</h3>
      <p class="module-copy" data-logs-total>共 0 条记录</p>
    </div>
    <div class="logs-actions">
      <label class="export-all-toggle">
        <input type="checkbox" data-export-all aria-label="导出全部数据" />
        <span>全部</span>
      </label>
      <button type="button" data-export-format="csv">导出 CSV</button>
      <button type="button" data-export-format="json">导出 JSON</button>
      <button type="button" data-range-delete>按时间范围删除</button>
      <button type="button" data-clear-all>清空全部</button>
    </div>
  </div>

  <p class="module-unavailable" data-logs-unavailable hidden>暂不可用</p>

  <div data-logs-content>
    <div class="logs-list" data-logs-list></div>
    <div class="logs-pagination">
      <button type="button" data-logs-prev>上一页</button>
      <span data-logs-page-info>第 1 / 1 页</span>
      <button type="button" data-logs-next>下一页</button>
    </div>
    <article class="log-detail" data-log-detail hidden>
      <h4>记录详情</h4>
      <dl data-log-detail-fields></dl>
    </article>
  </div>
</section>

<style>
  .logs-module {
    margin-bottom: 3rem;
  }

  .logs-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .export-all-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--fg-secondary);
    font-size: 0.85rem;
  }

  .logs-actions button,
  .logs-pagination button,
  .log-delete-button {
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-button);
    background: transparent;
    color: var(--fg-secondary);
    font: inherit;
  }

  .log-delete-button {
    padding: 0.25rem 0.6rem;
    color: var(--accent-dark);
    font-size: 0.8rem;
    cursor: pointer;
  }

  .logs-actions button:disabled,
  .logs-pagination button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .logs-list {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .log-row {
    display: grid;
    grid-template-columns: minmax(0, 180px) minmax(0, 1fr) auto auto auto;
    gap: 0.75rem;
    width: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-button);
    background: var(--bg);
    text-align: left;
    font: inherit;
    color: var(--fg);
    cursor: pointer;
  }

  .log-row-meta,
  .log-row-message {
    font-size: 0.88rem;
  }

  .log-row-message {
    color: var(--fg-secondary);
  }

  .log-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 5.5rem;
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-pill);
    background: var(--accent-bg);
    color: var(--accent-dark);
    font-size: 0.8rem;
  }

  .log-chip.status-success {
    background: var(--bg-muted);
    color: var(--fg-secondary);
  }

  .logs-pagination {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .log-detail {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .log-detail h4 {
    margin-bottom: 0.75rem;
    font-size: 1rem;
  }

  .log-detail dl {
    display: grid;
    grid-template-columns: minmax(120px, 180px) 1fr;
    gap: 0.6rem 1rem;
    font-size: 0.9rem;
  }

  .log-detail dt {
    color: var(--fg-muted);
  }

  .log-detail dd {
    margin: 0;
    white-space: pre-wrap;
  }

  .log-row-actions {
    display: flex;
    justify-content: flex-end;
  }

  @media (max-width: 720px) {
    .logs-actions {
      align-items: flex-start;
    }

    .log-row {
      grid-template-columns: 1fr;
    }

    .logs-pagination {
      justify-content: flex-start;
      flex-wrap: wrap;
    }

    .log-detail dl {
      grid-template-columns: 1fr;
    }
  }
</style>
